# ==============================================================================
# ElectionEasyBackEnd / VoterLens - Production Environment Template
# Target: pdf.electioneasy.in (Ubuntu 24.04 LTS, 4 Cores, 7.8 GiB RAM)
# NOTE: DO NOT COMMIT REAL CREDENTIALS. Fill in placeholders upon deployment.
# ==============================================================================

# Application Identity & Mode
ENVIRONMENT=production
DEBUG=false
APP_NAME=VoterLens
APP_VERSION=1.0.0
PORT=8001
LOG_LEVEL=INFO
ENABLE_DOCS=false

# Security & CORS (Host Nginx Reverse Proxy)
# Comma-separated list of allowed origins. Do NOT use wildcard '*' in production.
CORS_ORIGINS=https://pdf.electioneasy.in
CORS_ALLOW_CREDENTIALS=true
TRUSTED_PROXIES=127.0.0.1,::1

# PostgreSQL Database Configuration
# GENERATE A STRONG UNIQUE PASSWORD OUTSIDE THE REPO: e.g. openssl rand -base64 32
POSTGRES_USER=voterlens_app
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_GENERATED_PASSWORD
POSTGRES_DB=voterlens_prod

# Connection Strings used inside Docker Compose network (referencing 'postgres' service)
DATABASE_URL=postgresql+asyncpg://voterlens_app:REPLACE_WITH_STRONG_GENERATED_PASSWORD@postgres:5432/voterlens_prod
DATABASE_SYNC_URL=postgresql+psycopg2://voterlens_app:REPLACE_WITH_STRONG_GENERATED_PASSWORD@postgres:5432/voterlens_prod

# Database Connection Pool (Sized conservatively for 4 CPU / 7.8 GiB RAM VM)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

# Redis & Celery Message Broker (Internal Docker network referencing 'redis' service)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Celery Worker Concurrency & Execution Limits
# 2 concurrent processes prevent memory exhaustion during heavy EasyOCR PyTorch execution
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300

# Google Gemini LLM Settings (OPTIONAL)
# If left empty, the pipeline will 100% rely on local EasyOCR without failing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ENABLE_GEMINI_VISION=true
LLM_BATCH_SIZE=5
LLM_MAX_RETRIES=3
CASCADE_CONFIDENCE_THRESHOLD=0.82

# Local OCR Settings
OCR_LANGUAGES=hi,en
OCR_GPU=false
OCR_DPI=200

# Storage Directories & Ingestion Limits
UPLOAD_DIR=/app/uploads
REPORTS_DIR=/app/reports
SCRATCH_DIR=/app/scratch
MAX_FILE_SIZE=52428800           # 50 MB per single PDF
MAX_ZIP_SIZE=209715200           # 200 MB per ZIP archive
MAX_ZIP_FILES=100                # Maximum archive entries
MAX_ZIP_EXTRACTED_SIZE=524288000 # 500 MB max decompressed size
MAX_PDF_PAGES=500                # Maximum pages per document

# Quality & Validation Confidence Thresholds
CONFIDENCE_THRESHOLD=0.85
REVIEW_REQUIRED_THRESHOLD=0.70
