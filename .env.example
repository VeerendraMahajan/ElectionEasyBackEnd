# ==============================================================================
# VoterLens / ElectionEasyBackEnd - Local Development Environment Template
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
APP_NAME=VoterLens
APP_VERSION=1.0.0
PORT=8001
LOG_LEVEL=INFO
ENABLE_DOCS=true

# Security & CORS
CORS_ORIGINS=http://localhost:8001,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
TRUSTED_PROXIES=127.0.0.1,::1

# Database Settings (Local Docker or Native PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=voterlens_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voterlens_db
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/voterlens_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

# Redis & Celery Message Broker
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300

# Google Gemini LLM (Optional - system falls back to 100% local EasyOCR if not set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ENABLE_GEMINI_VISION=true
LLM_BATCH_SIZE=5
LLM_MAX_RETRIES=3
CASCADE_CONFIDENCE_THRESHOLD=0.82

# OCR Configuration
OCR_LANGUAGES=hi,en
OCR_GPU=false
OCR_DPI=200

# Storage Directories & Limits
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports
SCRATCH_DIR=./scratch
MAX_FILE_SIZE=52428800           # 50 MB
MAX_ZIP_SIZE=209715200           # 200 MB
MAX_ZIP_FILES=100
MAX_ZIP_EXTRACTED_SIZE=524288000 # 500 MB
MAX_PDF_PAGES=500

# Confidence Thresholds
CONFIDENCE_THRESHOLD=0.85
REVIEW_REQUIRED_THRESHOLD=0.70
