# Application Settings
ENVIRONMENT=development
DEBUG=true
APP_NAME=VoterLens
APP_VERSION=1.0.0

# Database Settings (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/electoral_db
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/electoral_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Google Gemini LLM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_BATCH_SIZE=10
LLM_MAX_RETRIES=3

# OCR Configuration
OCR_LANGUAGES=hi,en
OCR_GPU=false
OCR_DPI=150

# Storage & Upload Limits
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800     # 50 MB
MAX_ZIP_SIZE=209715200     # 200 MB
MAX_ZIP_FILES=100
MAX_ZIP_EXTRACTED_SIZE=524288000 # 500 MB

# Extraction & Confidence Thresholds
CONFIDENCE_THRESHOLD=0.85
REVIEW_REQUIRED_THRESHOLD=0.70
